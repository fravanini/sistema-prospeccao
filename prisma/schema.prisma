generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  nome      String
  senhaHash String
  criadoEm  DateTime   @default(now())
  sessoes   Sessao[]
  marcas    Marca[]
  campanhas Campanha[]
  templates Template[]
  configs   Config[]
}

model Sessao {
  token     String   @id
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime
  criadoEm  DateTime @default(now())
}

model Marca {
  id           Int         @id @default(autoincrement())
  usuarioId    Int
  usuario      Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nome         String
  site         String?
  instagram    String?
  categoria    String      @default("Outra")
  porte        String?
  origem       String?
  notas        String?
  fazPubli     Boolean     @default(false)
  rodaAnuncios Boolean     @default(false)
  temEcommerce Boolean     @default(false)
  jaInteragiu  Boolean     @default(false)
  naoContatar  Boolean     @default(false)
  status       String      @default("PESQUISADA")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  contatos     Contato[]
  interacoes   Interacao[]

  @@index([usuarioId])
}

model Contato {
  id         Int         @id @default(autoincrement())
  marcaId    Int
  marca      Marca       @relation(fields: [marcaId], references: [id], onDelete: Cascade)
  nome       String
  cargo      String?
  email      String?
  fonteEmail String?
  verificado Boolean     @default(false)
  linkedin   String?
  createdAt  DateTime    @default(now())
  interacoes Interacao[]
}

model Campanha {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nome      String
  pitchBase String?
  periodo   String?
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

model Template {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nome      String
  etapa     String   @default("INICIAL")
  assunto   String
  corpo     String
  createdAt DateTime @default(now())

  @@index([usuarioId])
}

model Interacao {
  id            Int      @id @default(autoincrement())
  marcaId       Int
  marca         Marca    @relation(fields: [marcaId], references: [id], onDelete: Cascade)
  contatoId     Int?
  contato       Contato? @relation(fields: [contatoId], references: [id], onDelete: SetNull)
  tipo          String
  assunto       String?
  corpo         String?
  resultado     String?
  gmailThreadId String?
  data          DateTime @default(now())
}

model Config {
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  chave     String
  valor     String

  @@id([usuarioId, chave])
}
