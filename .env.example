# Copie este arquivo para .env antes de rodar localmente:  cp .env.example .env
#
# String de conexão do Postgres.
# - Na Vercel: definida automaticamente ao criar o banco Neon pela plataforma.
# - Local: aponte para um Postgres seu (ou use o banco Neon de desenvolvimento).
DATABASE_URL="postgresql://usuario:senha@host:5432/nome_do_banco?sslmode=require"
